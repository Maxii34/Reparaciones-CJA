// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum RolUsuario {
  ADMIN
  TECNICO
}

enum EstadoOrden {
  RECIBIDO
  EN_DIAGNOSTICO
  ESPERANDO_REPUESTO
  EN_REPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
  MERCADO_PAGO
  OTRO
}

// Checkboxes de la ficha de recepción (punto 3-A) - puede marcarse más de uno
enum CondicionFisicaEquipo {
  BUEN_ESTADO
  GOLPES_ABOLLADURAS
  RAYONES_SUPERFICIALES
  PIEZAS_ROTAS_FALTANTES
}


model Usuario {
  id           Int        @id @default(autoincrement())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario @default(TECNICO)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relaciones
  ordenesCreadas   OrdenReparacion[]      @relation("OrdenesCreadasPor")
  ordenesAsignadas OrdenReparacion[]      @relation("OrdenesAsignadasA")
  pagosRegistrados Pago[]
  historialCambios HistorialEstadoOrden[]
  refreshTokens RefreshToken[]

  @@map("usuarios")
}

model RefreshToken {
  id            Int      @id @default(autoincrement())
  token         String   @unique
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  expiraEn      DateTime
  revocado      Boolean  @default(false)
  fechaCreacion DateTime @default(now())

  @@map("refresh_tokens")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  apellido  String?
  dni       String?  @unique
  telefono  String?
  whatsapp  String?
  email     String?
  direccion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipos Equipo[]

  @@map("clientes")
}


model Equipo {
  id            Int      @id @default(autoincrement())
  tipo          String // Ej: Heladera, Lavarropas, Microondas, TV, etc.
  marca         String
  modelo        String
  numeroSerie   String?
  observaciones String? // datos particulares del equipo

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordenes OrdenReparacion[]

  @@index([clienteId])
  @@map("equipos")
}


model OrdenReparacion {
  id     Int    @id @default(autoincrement())
  numero String @unique // Nro visible al cliente, ej: OR-0001

  equipoId Int
  equipo   Equipo @relation(fields: [equipoId], references: [id], onDelete: Restrict)

  // Ingreso
  fechaIngreso   DateTime @default(now())
  fallaReportada String
  accesorios     String? // Punto 3-B "Accesorios incluidos / Otros" de la ficha

  // Estado físico de recepción (Punto 3-A de la ficha, checkboxes + detalle)
  condicionFisica        CondicionFisicaEquipo[]
  detalleCondicionFisica String?

  // Diagnóstico
  diagnostico       String?
  pruebasRealizadas String?
  recomendaciones   String?

  // Presupuesto y autorización
  costoEstimado     Decimal?  @db.Decimal(10, 2) // lo presupuestado
  autorizadoCliente Boolean   @default(false)
  fechaAutorizacion DateTime?

  // Reparación
  reparacionRealizada String?
  manoDeObra          Decimal @default(0) @db.Decimal(10, 2)

  // Cobro
  precioFinal Decimal? @db.Decimal(10, 2) // lo finalmente cobrado
  estadoPago  EstadoPago @default(PENDIENTE)

  // Entrega y garantía
  fechaEntrega              DateTime?
  garantiaDias              Int     @default(90) // política estándar: 90 días (3 meses)
  conformidadEntregaCliente Boolean @default(false) // firma del cliente al retirar el equipo ya reparado

  // Conformidad de RECEPCIÓN (punto 5 de la ficha) - firmas al momento de dejar el equipo
  firmaClienteRecepcion Boolean @default(false)
  firmaTecnicoRecepcion Boolean @default(false)

  // Estado del flujo
  estado EstadoOrden @default(RECIBIDO)

  // Trazabilidad de usuarios
  creadoPorId Int?
  creadoPor   Usuario? @relation("OrdenesCreadasPor", fields: [creadoPorId], references: [id])
  tecnicoId   Int?
  tecnico     Usuario? @relation("OrdenesAsignadasA", fields: [tecnicoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repuestosUsados  RepuestoUsado[]
  pagos            Pago[]
  historialEstados HistorialEstadoOrden[]

  @@index([equipoId])
  @@index([estado])
  @@map("ordenes_reparacion")
}

// Historial de cambios de estado, para trazabilidad completa
model HistorialEstadoOrden {
  id Int @id @default(autoincrement())

  ordenId Int
  orden   OrdenReparacion @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  estado     EstadoOrden
  fecha      DateTime    @default(now())
  comentario String?

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([ordenId])
  @@map("historial_estados_orden")
}


model Repuesto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  stock       Int      @default(0)
  costo       Decimal  @db.Decimal(10, 2) // costo de compra/reposición
  precioVenta Decimal? @db.Decimal(10, 2) // precio de lista sugerido
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usos RepuestoUsado[]

  @@map("repuestos")
}

// Repuestos utilizados en una orden específica (detalle)
model RepuestoUsado {
  id Int @id @default(autoincrement())

  ordenId Int
  orden   OrdenReparacion @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  repuestoId Int
  repuesto   Repuesto @relation(fields: [repuestoId], references: [id], onDelete: Restrict)

  cantidad       Int     @default(1)
  costoUnitario  Decimal @db.Decimal(10, 2) // costo del repuesto al momento de usarlo
  precioUnitario Decimal @db.Decimal(10, 2) // precio cobrado al cliente por unidad

  createdAt DateTime @default(now())

  @@index([ordenId])
  @@index([repuestoId])
  @@map("repuestos_usados")
}


model Pago {
  id Int @id @default(autoincrement())

  ordenId Int
  orden   OrdenReparacion @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  monto         Decimal   @db.Decimal(10, 2)
  medioPago     MedioPago
  fecha         DateTime  @default(now())
  observaciones String?

  registradoPorId Int?
  registradoPor   Usuario? @relation(fields: [registradoPorId], references: [id])

  @@index([ordenId])
  @@map("pagos")
}